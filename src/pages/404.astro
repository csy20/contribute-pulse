---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pathTo } from "../lib/paths.ts";
---

<BaseLayout title="Not found · Contribute Pulse" description="That page is not on the board.">
  <section class="max-w-xl">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-display text-4xl tracking-tight sm:text-5xl">This page is not on the board.</h1>
    <p class="mt-4 max-w-[34em] text-moss">
      The link may be stale, or the repository dropped off the last crawl. The board only keeps
      projects that still pass the activity filters.
    </p>
    <p class="mt-8">
      <a class="btn-primary" href={pathTo("")}>Return home</a>
    </p>
  </section>
</BaseLayout>
