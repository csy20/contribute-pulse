---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pathTo } from "../lib/paths.ts";
---

<BaseLayout title="Not found · Contribute Pulse" description="That page is not on the board.">
  <section class="max-w-xl">
    <p class="text-xs uppercase tracking-[0.18em] text-moss">404</p>
    <h1 class="mt-3 font-display text-4xl tracking-tight">This page is not on the board.</h1>
    <p class="mt-4 text-moss">
      The link may be stale, or the repository dropped off the last crawl. The board only keeps
      projects that still pass the activity filters.
    </p>
    <p class="mt-6">
      <a class="text-lime hover:underline" href={pathTo("")}>Return home</a>
    </p>
  </section>
</BaseLayout>
