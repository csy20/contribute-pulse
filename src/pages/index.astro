---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import { categoryCounts, featuredRepos, latest } from "../lib/data.ts";
import { categoryPath, pathTo } from "../lib/paths.ts";
import { relativeTime } from "../lib/format.ts";

const counts = categoryCounts();
const featured = featuredRepos();
const q = Astro.url.searchParams.get("q") ?? "";
---

<BaseLayout title="Contribute Pulse" searchValue={q}>
  <section class="max-w-3xl">
    <p class="text-xs uppercase tracking-[0.18em] text-moss">
      Updated <time datetime={latest.generatedAt} data-relative>{relativeTime(latest.generatedAt)}</time>
      · {latest.repoCount} repos
    </p>
    <h1 class="mt-3 font-display text-[2.05rem] leading-[1.15] tracking-tight sm:text-5xl">
      Find a repo that is alive — and will notice your pull request.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-moss sm:text-lg">
      Browse AI/ML, web, systems, and language ecosystems. We only surface projects with recent
      maintainer activity and room for contributors.
    </p>
    <form class="mt-6" action={pathTo("")} method="get" role="search">
      <label class="sr-only" for="home-search">Search the board</label>
      <input
        id="home-search"
        data-home-search
        type="search"
        name="q"
        value={q}
        placeholder="pytorch vision, rust cli, android"
        class="w-full px-4 py-3 text-base"
        autocomplete="off"
      />
    </form>
  </section>

  <section data-search-results hidden class="mt-10">
    <h2 data-search-heading class="font-display text-2xl">Search results</h2>
    <div data-search-grid class="mt-5 grid gap-3 sm:grid-cols-2"></div>
  </section>

  <div data-home-default>
    <section class="mt-12">
      <h2 class="font-display text-2xl">Categories</h2>
      <ul class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          counts.map((cat) => (
            <li>
              <a
                href={categoryPath(cat.slug)}
                class="card flex items-center justify-between gap-3 hover:border-lime/40"
              >
                <span class="font-medium">{cat.name}</span>
                <span class="font-mono text-sm tabular-nums text-moss">{cat.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <div class="flex items-end justify-between gap-3">
        <h2 class="font-display text-2xl">Featured</h2>
        <p class="text-sm text-moss">Top 8 by contribute score</p>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {featured.map((repo) => <RepoCard repo={repo} />)}
      </div>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="font-display text-2xl">How scoring works</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-moss">
        <li>
          <span class="text-ink">Mid-size over celebrity.</span>
          Repos in the thousands of stars score higher than mega-repos where a PR is easy to miss.
        </li>
        <li>
          <span class="text-ink">Recent maintainer activity beats raw stars.</span>
          Last push, merged PRs, and CONTRIBUTING.md carry more weight than a star count.
        </li>
        <li>
          <span class="text-ink">There has to be a place to start.</span>
          The default board only lists projects with an open starter-style issue.
        </li>
      </ul>
      <p class="mt-4 text-sm">
        <a class="text-lime hover:underline" href={pathTo("about/")}>Full scoring notes and caveats</a>
      </p>
    </section>
  </div>

  <script>
    import { initHomeSearch } from "../lib/home-search.ts";
    initHomeSearch();
  </script>
</BaseLayout>
