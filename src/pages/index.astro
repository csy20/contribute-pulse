---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import {
  categoryCounts,
  featuredRepos,
  latest,
  pulseStats,
} from "../lib/data.ts";
import { categoryPath, pathTo } from "../lib/paths.ts";
import { isStale, relativeTime } from "../lib/format.ts";
import { categoryIcon } from "../lib/ui.ts";

const counts = categoryCounts();
const featured = featuredRepos();
const pulse = pulseStats();
const q = Astro.url.searchParams.get("q") ?? "";
const examples = ["Python", "TypeScript", "Rust", "good first issue"];
---

<BaseLayout
  title="Contribute Pulse · Find your next contribution"
  searchValue={q}
  home
>
  <section class="board-intro" aria-labelledby="hero-title">
    <div class="board-intro-copy">
      <p class="page-kicker">Open source, open possibilities</p>
      <h1 id="hero-title">
        Find your next <em>contribution.</em>
      </h1>
      <p class="board-intro-description">
        Discover open-source projects with active maintainers and a place to
        start.
      </p>
    </div>
    <aside class="board-overview" aria-label="Board overview">
      <div class="overview-metrics">
        <div>
          <strong>{pulse.repoCount}</strong>
          <span>repositories</span>
        </div>
        <div>
          <strong>{pulse.issueCount}</strong>
          <span>starter issues</span>
        </div>
        <div>
          <strong>{pulse.languages}</strong>
          <span>languages</span>
        </div>
      </div>
      <p
        class:list={[
          "overview-updated",
          { "snapshot-stale": isStale(latest.generatedAt) },
        ]}
        data-snapshot-status
        data-generated-at={latest.generatedAt}
      >
        <span class="live-dot" aria-hidden="true"></span> Refreshed{" "}
        <time datetime={latest.generatedAt} data-relative>
          {relativeTime(latest.generatedAt)}
        </time>
      </p>
    </aside>
  </section>

  <section class="search-section" id="explore" aria-label="Find repositories">
    <form class="hero-search" action={pathTo("")} method="get" role="search">
      <div class="search-wrap">
        <label class="sr-only" for="home-search">
          Search the board
        </label>
        <svg
          class="search-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="10.5"
            cy="10.5"
            r="6.5"
            stroke="currentColor"
            stroke-width="1.7"
          />
          <path
            d="m16 16 4.5 4.5"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          />
        </svg>
        <input
          id="home-search"
          data-home-search
          type="search"
          name="q"
          value={q}
          placeholder="Search projects, languages, topics…"
          class="field field-lg"
          autocomplete="off"
        />
        <kbd class="search-key" aria-hidden="true">
          /
        </kbd>
      </div>
      <button type="submit" class="btn-primary">
        Search <span aria-hidden="true">↗</span>
      </button>
    </form>
    <div class="search-suggestions">
      <span>Quick searches</span>
      {examples.map((ex) => (
        <button
          type="button"
          class="example-chip"
          data-search-chip={ex}
          aria-pressed="false"
        >
          {ex}
          <span aria-hidden="true">↗</span>
        </button>
      ))}
    </div>
  </section>

  <div class="discovery-layout" data-home-default>
    <aside class="category-sidebar">
      <div class="sidebar-heading">
        <h2>Categories</h2>
        <span>{counts.length}</span>
      </div>
      <nav class="category-nav" aria-label="Categories">
        <a
          class="category-link active"
          href="#repository-board"
          aria-current="page"
        >
          <span class="category-mark">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="7" height="7" rx="2" />
              <rect x="14" y="3" width="7" height="7" rx="2" />
              <rect x="3" y="14" width="7" height="7" rx="2" />
              <rect x="14" y="14" width="7" height="7" rx="2" />
            </svg>
          </span>
          <span>Featured projects</span>
          <span class="category-count">{featured.length}</span>
        </a>
        {counts.map((cat) => (
          <a class="category-link" href={categoryPath(cat.slug)}>
            <span class="category-mark">
              <Fragment set:html={categoryIcon(cat.slug)} />
            </span>
            <span>{cat.name}</span>
            <span class="category-count">{cat.count}</span>
          </a>
        ))}
      </nav>
      <div class="sidebar-note">
        <span class="note-icon" aria-hidden="true">
          ↗
        </span>
        <h3>A good place to begin.</h3>
        <p>
          Every project on the board has an open contributor-oriented issue.
        </p>
        <a href={pathTo("about/")}>
          How we pick projects <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
    <section id="repository-board" class="repository-board">
      <div class="board-heading">
        <h2>
          Featured repositories<span class="heading-dot">.</span>
        </h2>
        <span class="board-sort">
          Sorted by Pulse score <span aria-hidden="true">↓</span>
        </span>
      </div>
      <div class="board-context">
        <span class="board-result-count">
          <span class="result-count">{featured.length}</span> projects to
          explore
        </span>
        <a href={pathTo("about/")}>
          How we rank projects <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="repo-grid">
        {featured.map((repo) => (
          <RepoCard repo={repo} />
        ))}
      </div>
      <div class="board-end">
        <span>There’s more where these came from.</span>
        <a href="#explore">
          Search {pulse.repoCount} repositories{" "}
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </section>
  </div>

  <section data-search-results hidden class="search-results">
    <div class="board-heading">
      <div>
        <p class="eyebrow">THE DISCOVERY BOARD</p>
        <h2 data-search-heading aria-live="polite">
          Search results
        </h2>
      </div>
      <label class="search-sort-label">
        Sort by
        <select data-search-sort class="field">
          <option value="score">Best to contribute</option>
          <option value="stars">Most stars</option>
          <option value="pushed">Recently pushed</option>
          <option value="issues">Most open starter issues</option>
        </select>
      </label>
    </div>
    <div data-search-cats class="search-categories"></div>
    <div
      data-search-grid
      class="board-grid"
    ></div>
  </section>

  <section class="method-section">
    <div class="method-intro">
      <p class="eyebrow">SIGNAL OVER NOISE</p>
      <h2>
        Built for contributors.
        <br />
        <em>Not star collectors.</em>
      </h2>
      <a href={pathTo("about/")}>
        Meet the scoring system <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ol class="method-steps">
      <li>
        <span>01 /</span>
        <h3>Activity comes first</h3>
        <p>
          Recent pushes and merged pull requests show a project is moving
          forward.
        </p>
      </li>
      <li>
        <span>02 /</span>
        <h3>People on the other side</h3>
        <p>
          Maintainer signals and contributing guides help you find a receptive
          project.
        </p>
      </li>
      <li>
        <span>03 /</span>
        <h3>An issue with your name on it</h3>
        <p>
          Open starter-style issues give you a clear place to make your first
          contribution.
        </p>
      </li>
    </ol>
  </section>
  <script>
    import { initHomeSearch } from "../lib/home-search.ts";
    initHomeSearch();
  </script>
</BaseLayout>
