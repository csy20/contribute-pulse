---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import { categoryCounts, featuredRepos, latest } from "../lib/data.ts";
import { categoryPath, pathTo } from "../lib/paths.ts";
import { relativeTime } from "../lib/format.ts";
import { CATEGORY_MARK } from "../lib/ui.ts";

const counts = categoryCounts();
const featured = featuredRepos();
const q = Astro.url.searchParams.get("q") ?? "";
const examples = ["pytorch vision", "rust cli", "android", "good first issue"];
---

<BaseLayout title="Contribute Pulse" searchValue={q} home>
  <section class="max-w-xl">
    <p class="eyebrow">
      <span class="live-dot" aria-hidden="true"></span>
      Updated <time datetime={latest.generatedAt} data-relative>{relativeTime(latest.generatedAt)}</time>
      · {latest.repoCount} repos
    </p>
    <h1 class="mt-4 font-display text-[2.25rem] leading-[1.12] sm:text-[3.5rem]">
      Find a repo that is alive — and will notice your pull request.
    </h1>
    <p class="mt-4 max-w-[34em] text-[15px] leading-relaxed text-moss sm:text-lg">
      Browse AI/ML, web, systems, and language ecosystems. We only surface projects with recent
      maintainer activity and room for contributors.
    </p>
    <form class="search-wrap mt-7" action={pathTo("")} method="get" role="search">
      <label class="sr-only" for="home-search">Search the board</label>
      <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="home-search"
        data-home-search
        type="search"
        name="q"
        value={q}
        placeholder="pytorch vision, rust cli, android"
        class="field field-lg"
        autocomplete="off"
      />
    </form>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        examples.map((ex) => (
          <button type="button" class="example-chip" data-search-chip={ex}>
            {ex}
          </button>
        ))
      }
    </div>
  </section>

  <section data-search-results hidden class="mt-14">
    <p class="eyebrow">Search</p>
    <h2 data-search-heading class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">Search results</h2>
    <div data-search-grid class="mt-6 grid gap-3 sm:grid-cols-2"></div>
  </section>

  <div data-home-default>
    <section class="mt-16 sm:mt-20">
      <p class="eyebrow">Browse</p>
      <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">Categories</h2>
      <ul class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
        {
          counts.map((cat) => (
            <li>
              <a href={categoryPath(cat.slug)} class="cat-tile">
                <span class="cat-mark">{CATEGORY_MARK[cat.slug]}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-medium text-ink">{cat.name}</span>
                  <span class="mt-0.5 block font-mono text-xs tabular-nums text-moss">{cat.count}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16 sm:mt-20">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="eyebrow">Board</p>
          <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">Highest contribute score</h2>
        </div>
        <p class="text-sm text-moss">Top 8 · mid-size, recently pushed</p>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {featured.map((repo) => <RepoCard repo={repo} />)}
      </div>
    </section>

    <section class="mt-16 sm:mt-20">
      <p class="eyebrow">Method</p>
      <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">How scoring works</h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-3">
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">01</p>
          <h3 class="mt-2 font-display text-xl">Mid-size over celebrity</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            Repos in the thousands of stars score higher than mega-repos where a PR is easy to miss.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">02</p>
          <h3 class="mt-2 font-display text-xl">Activity beats raw stars</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            Last push, merged PRs, and CONTRIBUTING.md carry more weight than a star count.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">03</p>
          <h3 class="mt-2 font-display text-xl">A place to start</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            The default board only lists projects with an open starter-style issue.
          </p>
        </li>
      </ol>
      <p class="mt-8">
        <a class="btn-ghost" href={pathTo("about/")}>Full scoring notes and caveats</a>
      </p>
    </section>
  </div>

  <script>
    import { initHomeSearch } from "../lib/home-search.ts";
    initHomeSearch();
  </script>
</BaseLayout>
