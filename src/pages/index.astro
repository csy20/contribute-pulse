---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import { categoryCounts, featuredRepos, latest, pulseStats } from "../lib/data.ts";
import { categoryPath, pathTo } from "../lib/paths.ts";
import { nextCrawlLabel, relativeTime } from "../lib/format.ts";

const counts = categoryCounts();
const featured = featuredRepos();
const pulse = pulseStats();
const q = Astro.url.searchParams.get("q") ?? "";
const examples = ["pytorch vision", "rust cli", "android", "good first issue"];
const nextCrawl = nextCrawlLabel();
---

<BaseLayout title="Contribute Pulse" searchValue={q} home>
  <section class="hero-in hero-split">
    <div class="hero-title">
      <h1 class="hero-heading font-display text-[2.25rem] leading-[1.12] sm:text-[3.35rem]">
        Find a repo that is alive — and will notice your pull request.
      </h1>
    </div>

    <div class="hero-rail">
      <p class="eyebrow">
        <span class="live-dot" aria-hidden="true"></span>
        Updated <time datetime={latest.generatedAt} data-relative>{relativeTime(latest.generatedAt)}</time>
        · <span data-next-crawl>{nextCrawl}</span>
      </p>
      <p class="mt-3 mb-4 max-w-[34em] text-[15px] leading-relaxed text-moss sm:text-lg">
        Browse AI/ML, web, systems, and language ecosystems. We only surface projects with recent
        maintainer activity and room for contributors.
      </p>
      <form class="hero-search" action={pathTo("")} method="get" role="search">
        <div class="search-wrap">
          <label class="sr-only" for="home-search">Search the board</label>
          <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <input
            id="home-search"
            data-home-search
            type="search"
            name="q"
            value={q}
            placeholder="pytorch vision, rust cli, android"
            class="field field-lg"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="btn-primary">Search the board</button>
      </form>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {
          examples.map((ex) => (
            <button type="button" class="example-chip" data-search-chip={ex}>
              {ex}
            </button>
          ))
        }
      </div>

      <aside class="pulse-card mt-5" aria-label="Pulse status">
      <p class="eyebrow">Pulse</p>
      <p class="mt-2 font-mono text-4xl tabular-nums tracking-tight text-ink sm:text-5xl">{pulse.repoCount}</p>
      <p class="mt-1 text-sm text-moss">repos on the board</p>

      <div class="mt-5">
        <div class="pulse-stat">
          <span class="text-moss">Updated</span>
          <time class="font-mono tabular-nums text-ink" datetime={latest.generatedAt} data-relative>
            {relativeTime(latest.generatedAt)}
          </time>
        </div>
        <div class="pulse-stat">
          <span class="text-moss">Next crawl</span>
          <span class="font-mono tabular-nums text-ink" data-next-crawl>{nextCrawl}</span>
        </div>
        <div class="pulse-stat">
          <span class="text-moss">Starter issues</span>
          <span class="font-mono tabular-nums text-ink">{pulse.issueCount}</span>
        </div>
        <div class="pulse-stat">
          <span class="text-moss">Languages</span>
          <span class="font-mono tabular-nums text-ink">{pulse.languages}</span>
        </div>
      </div>

      <p class="eyebrow mt-6">Why these repos?</p>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-moss">
        <li>Activity beats stars.</li>
        <li>Maintainer responsiveness matters.</li>
        <li>Starter issues matter.</li>
      </ul>
      <p class="mt-4">
        <a class="text-sm text-ink/80 underline decoration-line underline-offset-4 hover:text-ink" href={pathTo("about/")}>
          See how Pulse scores
        </a>
      </p>
      </aside>
    </div>

    <div class="hero-board mt-10 lg:mt-0" data-home-default>
      <section>
        <p class="eyebrow">Browse</p>
        <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">Categories</h2>
        <nav class="cat-strip mt-5" aria-label="Categories">
          {
            counts.map((cat) => (
              <a class="cat-chip" href={categoryPath(cat.slug)}>
                <span>{cat.name}</span>
                <span class="n">{cat.count}</span>
              </a>
            ))
          }
        </nav>
      </section>

      <section class="mt-12">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">Board</p>
            <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">Highest contribute score</h2>
          </div>
          <p class="text-sm text-moss">Top 8 · mid-size, recently pushed</p>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {featured.map((repo) => <RepoCard repo={repo} />)}
        </div>
      </section>
    </div>
  </section>

  <section data-search-results hidden class="mt-14">
    <p class="eyebrow">Search</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
      <h2 data-search-heading class="font-display text-[1.65rem] sm:text-[1.75rem]" aria-live="polite">
        Search results
      </h2>
      <label class="grid gap-1 text-[11px] uppercase tracking-[0.12em] text-moss">
        Sort
        <select data-search-sort class="field h-11 min-w-[11rem] text-sm text-ink">
          <option value="score">Best to contribute</option>
          <option value="stars">Most stars</option>
          <option value="pushed">Recently pushed</option>
          <option value="issues">Most open starter issues</option>
        </select>
      </label>
    </div>
    <div data-search-cats class="mt-3 flex flex-wrap gap-1.5"></div>
    <div data-search-grid class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <section class="mt-16 sm:mt-20">
      <p class="eyebrow">Method</p>
      <h2 class="mt-2 font-display text-[1.65rem] sm:text-[1.75rem]">How scoring works</h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-3">
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">01</p>
          <h3 class="mt-2 font-display text-xl">Mid-size over celebrity</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            Repos in the thousands of stars score higher than mega-repos where a PR is easy to miss.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">02</p>
          <h3 class="mt-2 font-display text-xl">Activity beats raw stars</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            Last push, merged PRs, and CONTRIBUTING.md carry more weight than a star count.
          </p>
        </li>
        <li>
          <p class="font-mono text-xs tabular-nums text-lime-dim">03</p>
          <h3 class="mt-2 font-display text-xl">A place to start</h3>
          <p class="mt-2 text-sm leading-relaxed text-moss">
            The default board only lists projects with an open starter-style issue.
          </p>
        </li>
      </ol>
      <p class="mt-8">
        <a class="btn-ghost" href={pathTo("about/")}>Full scoring notes and caveats</a>
      </p>
    </section>

  <script>
    import { initHomeSearch } from "../lib/home-search.ts";
    initHomeSearch();
  </script>
</BaseLayout>
