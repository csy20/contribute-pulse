---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pathTo } from "../lib/paths.ts";

const recipe = [
  { signal: "Star band", weight: "18%", measures: "Mid-size repos (about 300–15k stars) score highest. Mega-repos are penalized." },
  { signal: "Freshness", weight: "28%", measures: "Last push in the last week scores 100; older than 45 days is excluded." },
  { signal: "Maintainer signal", weight: "24%", measures: "Recent merged PRs, CONTRIBUTING.md, code of conduct, and a penalty if open PRs dwarf recent merges." },
  { signal: "Issue quality", weight: "20%", measures: "Starter-style issues that are recent, unassigned, and not already crowded with comments." },
  { signal: "Project health", weight: "10%", measures: "License, topics, README, plus a weak forks/watchers signal." },
];

const filters = [
  "Public, not archived, not a fork",
  "Has a license, a description, and a default branch",
  "Pushed in the last 45 days",
  "80–80,000 stars (mega-repos only via “Include mega-repos”)",
  "At least one open issue labeled good first issue, help wanted, first-timers-only, beginner friendly, documentation, or hacktoberfest",
];
---

<BaseLayout title="About · Contribute Pulse" description="How Contribute Pulse ranks repositories, what the crawl includes, and how to fall off the board.">
  <article class="about-page">
    <header class="page-heading">
      <p class="page-kicker">About</p>
      <h1>About the board</h1>
      <p class="about-intro">
        Contribute Pulse is a static discovery board for public GitHub repositories that are popular
        enough to matter, active enough that a pull request can actually get reviewed, and labeled
        enough that a new contributor has a place to start.
      </p>
    </header>

    <section class="about-section" aria-labelledby="score-recipe-title">
      <h2 class="section-title" id="score-recipe-title">Score recipe</h2>
      <p>
        Each listed repo gets a contribute score from 0–100. It is a weighted sum of five signals.
      </p>
      <div class="recipe-table-wrap">
        <table class="recipe-table">
          <thead>
            <tr>
              <th scope="col">Signal</th>
              <th scope="col">Weight</th>
              <th scope="col">What it measures</th>
            </tr>
          </thead>
          <tbody>
            {
              recipe.map((row) => (
                <tr>
                  <td>{row.signal}</td>
                  <td>{row.weight}</td>
                  <td>{row.measures}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="about-section" aria-labelledby="hard-filters-title">
      <h2 class="section-title" id="hard-filters-title">Hard filters</h2>
      <p>A repository is listed only if all of these hold:</p>
      <ul>
        {
          filters.map((item) => (
            <li class="check-row">
              <svg class="tick" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M1 6h2.1l1-3.2L6.2 10l1.3-4H11"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section" aria-labelledby="caveats-title">
      <h2 class="section-title" id="caveats-title">Caveats</h2>
      <ul>
        <li>Data is delayed up to 12 hours. The crawl runs at 02:00 and 14:00 UTC.</li>
        <li>Labels are imperfect. Maintainers reuse names, and GitHub search misses some of them.</li>
        <li>Always read the issue, contributing guide, and recent PR history before starting work.</li>
        <li>Category tags come from topics, language, and description keywords. Guessing is disclosed by also placing weak matches in Other.</li>
        <li>Merged-PR counts are sampled from the GraphQL API. When that sample is thin, maintainer activity is estimated from push recency.</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="get-listed-title">
      <h2 class="section-title" id="get-listed-title">How to get listed</h2>
      <p>
        There is no submit form in v1. If a public repository matches the filters on the next
        crawl, it can appear. Topics, a license, a CONTRIBUTING.md, and a genuine starter issue help.
      </p>
    </section>

    <section class="about-section" aria-labelledby="be-excluded-title">
      <h2 class="section-title" id="be-excluded-title">How to be excluded</h2>
      <p>
        Archive the repository, remove the license, or go quiet for 45 days and it will drop off the
        next crawl. To request a removal from a current board snapshot, open an issue on
        <a href="https://github.com/csy20/contribute-pulse">
          the project repo
        </a>.
      </p>
    </section>

    <p class="about-actions">
      <a class="btn-ghost" href={pathTo("")}>Back to the board</a>
      <a
        class="text-link"
        href="https://coff.ee/the__csy20"
        rel="noopener noreferrer"
      >
        Buy me a coffee
      </a>
    </p>
  </article>
</BaseLayout>
