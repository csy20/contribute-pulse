---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ScoreBars from "../../../components/ScoreBars.astro";
import { CATEGORY_NAME } from "../../../../scripts/types.ts";
import { latest } from "../../../lib/data.ts";
import { formatScore, formatStars, relativeTime, safeHttpUrl } from "../../../lib/format.ts";
import { categoryPath, pathTo } from "../../../lib/paths.ts";
import { avatarUrl, languageColor } from "../../../lib/ui.ts";

export function getStaticPaths() {
  return latest.repos.map((repo) => ({
    params: { owner: repo.owner, name: repo.name },
    props: { repo },
  }));
}

const { repo } = Astro.props;
const langColor = languageColor(repo.language);
const homepage = safeHttpUrl(repo.homepage);
---

<BaseLayout title={`${repo.fullName} · Contribute Pulse`} description={repo.description}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={pathTo("")}>Board</a>
    <span aria-hidden="true">/</span>
    <a href={categoryPath(repo.primaryCategory)}>{CATEGORY_NAME[repo.primaryCategory]}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{repo.name}</span>
  </nav>

  <div class="detail-layout">
    <div class="detail-main">
      <header class="page-heading">
        <div class="detail-identity">
          <span class="detail-avatar-wrap" aria-hidden="true">
            <span class="repo-avatar-fallback">{repo.owner.slice(0, 2).toUpperCase()}</span>
            <img
              src={avatarUrl(repo.owner, 80)}
              alt=""
              width="40"
              height="40"
              class="detail-avatar repo-avatar"
            />
          </span>
          <div class="detail-name-wrap">
            <p class="detail-owner">{repo.owner}</p>
            <h1>{repo.name}</h1>
          </div>
        </div>
        <p class="detail-description">{repo.description}</p>
      </header>

      <div class="detail-tags">
        {
          repo.language && (
            <span class="pill">
              <span class="lang-dot" style={`background:${langColor}`}></span>
              {repo.language}
            </span>
          )
        }
        {repo.license && <span class="pill">{repo.license}</span>}
        {
          repo.categories.map((c) => (
            <a class="pill" href={categoryPath(c)}>
              {CATEGORY_NAME[c]}
            </a>
          ))
        }
        {repo.hasContributing && <span class="pill">CONTRIBUTING.md</span>}
        {repo.famousHard && <span class="pill text-danger">Famous but hard</span>}
      </div>

      <div class="stat-strip">
        <div class="meta-cell">
          <span class="lbl">Stars</span>
          <span class="val">{formatStars(repo.stars)}</span>
        </div>
        <div class="meta-cell">
          <span class="lbl">Forks</span>
          <span class="val">{formatStars(repo.forks)}</span>
        </div>
        <div class="meta-cell">
          <span class="lbl">Open issues</span>
          <span class="val">{repo.openIssues}</span>
        </div>
        <div class="meta-cell">
          <span class="lbl">Last push</span>
          <span class="val">
            <time datetime={repo.pushedAt} data-relative>{relativeTime(repo.pushedAt)}</time>
          </span>
        </div>
      </div>

      <div class="detail-actions">
        <a class="btn-primary" href={repo.url} rel="noopener noreferrer">Open on GitHub</a>
        {
          homepage && (
            <a class="btn-ghost" href={homepage} rel="noopener noreferrer">
              Homepage
            </a>
          )
        }
      </div>

    </div>

    <aside class="detail-score-panel" aria-label="Contribution signals">
      <div class="score-summary">
        <p class="page-kicker">Contribute score</p>
        <p class="score-num">
          {formatScore(repo.contributeScore)}<span class="score-unit">/100</span>
        </p>
        {
          repo.signalConfidence === "low" && (
            <p class="score-confidence">Maintainer activity estimated from push recency.</p>
          )
        }
      </div>
      <ScoreBars breakdown={repo.scoreBreakdown} />
      <ul class="detail-reasons">
        {
          repo.why.map((item) => (
            <li>
              <svg class="why-tick" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path
                  d="M1 6h2.1l1-3.2L6.2 10l1.3-4H11"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      {
        repo.riskFlags.length > 0 && (
          <div class="risk-panel">
            <p class="page-kicker">Risk flags</p>
            <ul>
              {repo.riskFlags.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>

    <section class="detail-section" aria-labelledby="recommended-issues-title">
      <h2 class="section-title" id="recommended-issues-title">Recommended issues</h2>
      <p>Issues stay on GitHub. Read the thread before starting work.</p>
      <ul class="issue-list">
        {
          repo.issues.map((issue) => (
            <li>
              <a class="issue-row" href={issue.url} rel="noopener noreferrer">
                <p class="issue-heading">
                  <span class="issue-number">#{issue.number}</span>
                  <span class="issue-title">{issue.title}</span>
                </p>
                <p class="issue-labels">
                  {issue.labels.map((label) => (
                    <span class="pill">{label}</span>
                  ))}
                </p>
                <p class="issue-meta">
                  updated <time datetime={issue.updatedAt} data-relative>{relativeTime(issue.updatedAt)}</time>
                  · {issue.comments} {issue.comments === 1 ? "comment" : "comments"}
                  {issue.isAssigned ? " · assigned" : " · unassigned"}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="detail-section" aria-labelledby="topics-title">
      <h2 class="section-title" id="topics-title">Topics</h2>
      <div class="topic-list">
        {
          repo.topics.length ? (
            repo.topics.map((t) => <span class="pill">{t}</span>)
          ) : (
            <p>No topics listed on GitHub.</p>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
