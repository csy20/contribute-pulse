---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RepoCard from "../../components/RepoCard.astro";
import { CATEGORY_DEFS, reposForCategory } from "../../lib/data.ts";
import { languagesIn } from "../../lib/search.ts";
import { pathTo } from "../../lib/paths.ts";
import type { CategorySlug } from "../../../scripts/types.ts";

export function getStaticPaths() {
  return CATEGORY_DEFS.map((cat) => ({
    params: { category: cat.slug },
    props: { def: cat },
  }));
}

const { def } = Astro.props;
const repos = reposForCategory(def.slug as CategorySlug);
const languages = languagesIn(repos);
---

<BaseLayout
  title={`${def.name} · Contribute Pulse`}
  description={`Active repositories in ${def.name} that still review pull requests.`}
>
  <section class="category-page" data-board data-category={def.slug}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={pathTo("")}>Board</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{def.name}</span>
    </nav>
    <header class="page-heading">
      <div class="page-heading-row">
        <h1>{def.name}</h1>
        <p data-count>
          {repos.length} {repos.length === 1 ? "repo" : "repos"}
        </p>
      </div>
      <p>
        Ranked by contribution-worthiness, not star count. Default view hides mega-repos.
      </p>
    </header>

    <form data-filters class="filter-bar" aria-label="Filter repositories">
      <label class="filter-field">
        Language
        <select name="language" class="field">
          <option value="">Any language</option>
          {languages.map((lang) => <option value={lang}>{lang}</option>)}
        </select>
      </label>
      <fieldset class="filter-field filter-stars">
        <legend>Stars</legend>
        <div class="filter-star-inputs">
          <input
            type="number"
            name="minStars"
            min="0"
            inputmode="numeric"
            class="field"
            placeholder="80"
            aria-label="Minimum stars"
          />
          <span aria-hidden="true">–</span>
          <input
            type="number"
            name="maxStars"
            min="0"
            inputmode="numeric"
            class="field"
            placeholder="80k"
            aria-label="Maximum stars"
          />
        </div>
      </fieldset>
      <label class="filter-field">
        Sort
        <select name="sort" class="field">
          <option value="score">Best to contribute</option>
          <option value="stars">Most stars</option>
          <option value="pushed">Recently pushed</option>
          <option value="issues">Most open starter issues</option>
        </select>
      </label>
      <div class="filter-toggles">
        <label class="chip">
          <input type="checkbox" name="beginnerOnly" class="sr-only" />
          Beginner friendly
        </label>
        <label class="chip">
          <input type="checkbox" name="hasContributing" class="sr-only" />
          Has CONTRIBUTING.md
        </label>
        <label class="chip">
          <input type="checkbox" name="famousHard" class="sr-only" />
          Include mega-repos
        </label>
      </div>
    </form>

    <div data-grid class="board-grid">
      {
        repos.length ? (
          repos.map((repo) => <RepoCard repo={repo} />)
        ) : (
          <div class="empty-state">
            <h2>Nothing here yet</h2>
            <p>
              Nothing in this category right now. The crawl only keeps licensed, recently
              pushed projects with starter labels.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <script>
    import { initBoard } from "../../lib/board.ts";
    initBoard();
  </script>
</BaseLayout>
