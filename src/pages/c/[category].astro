---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RepoCard from "../../components/RepoCard.astro";
import { CATEGORY_DEFS, reposForCategory } from "../../lib/data.ts";
import { languagesIn } from "../../lib/search.ts";
import type { CategorySlug } from "../../../scripts/types.ts";

export function getStaticPaths() {
  return CATEGORY_DEFS.map((cat) => ({
    params: { category: cat.slug },
    props: { def: cat },
  }));
}

const { def } = Astro.props;
const repos = reposForCategory(def.slug as CategorySlug);
const languages = languagesIn(repos);
---

<BaseLayout title={`${def.name} · Contribute Pulse`} description={`Active repositories in ${def.name} that still review pull requests.`}>
  <section data-board data-category={def.slug}>
    <p class="text-xs uppercase tracking-[0.18em] text-moss">Category</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
      <h1 class="font-display text-4xl tracking-tight">{def.name}</h1>
      <p data-count class="font-mono text-sm text-moss">{repos.length} {repos.length === 1 ? "repo" : "repos"}</p>
    </div>
    <p class="mt-3 max-w-2xl text-moss">
      Ranked by contribution-worthiness, not star count. Default view hides mega-repos.
    </p>

    <form data-filters class="mt-6 grid gap-3 rounded-2xl border border-line bg-panel p-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="grid gap-1 text-xs text-moss">
        Language
        <select name="language" class="px-2 py-2 text-sm text-ink">
          <option value="">Any language</option>
          {languages.map((lang) => <option value={lang}>{lang}</option>)}
        </select>
      </label>
      <label class="grid gap-1 text-xs text-moss">
        Min stars
        <input type="number" name="minStars" min="0" inputmode="numeric" class="px-2 py-2 text-sm" placeholder="80" />
      </label>
      <label class="grid gap-1 text-xs text-moss">
        Max stars
        <input type="number" name="maxStars" min="0" inputmode="numeric" class="px-2 py-2 text-sm" placeholder="80000" />
      </label>
      <label class="grid gap-1 text-xs text-moss">
        Sort
        <select name="sort" class="px-2 py-2 text-sm text-ink">
          <option value="score">Best to contribute</option>
          <option value="stars">Most stars</option>
          <option value="pushed">Recently pushed</option>
          <option value="issues">Most open starter issues</option>
        </select>
      </label>
      <label class="flex items-center gap-2 text-sm text-ink sm:col-span-2">
        <input type="checkbox" name="beginnerOnly" class="accent-lime" />
        Beginner friendly only
      </label>
      <label class="flex items-center gap-2 text-sm text-ink">
        <input type="checkbox" name="hasContributing" class="accent-lime" />
        Has CONTRIBUTING.md
      </label>
      <label class="flex items-center gap-2 text-sm text-ink">
        <input type="checkbox" name="famousHard" class="accent-lime" />
        Famous but hard
      </label>
    </form>

    <div data-grid class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        repos.length ? (
          repos.map((repo) => <RepoCard repo={repo} />)
        ) : (
          <div class="card col-span-full text-center">
            <p class="font-display text-xl">Nothing here yet</p>
            <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed text-moss">
              Nothing in this category right now. The daily crawl only keeps licensed, recently
              pushed projects with starter labels.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <script>
    import { initBoard } from "../../lib/board.ts";
    initBoard();
  </script>
</BaseLayout>
