---
import { pathTo } from "../lib/paths.ts";

const connectedSites = [
  {
    id: "csy20",
    name: "csy20.me",
    domain: "csy20.me",
    url: "https://csy20.me",
    icon: pathTo("sites/csy20.webp"),
    lightWell: false,
  },
  {
    id: "02-os",
    name: "02_OS",
    domain: "02os.xyz",
    url: "https://02os.xyz",
    icon: pathTo("sites/02-os.svg"),
    lightWell: true,
  },
  {
    id: "bytewise",
    name: "ByteWise",
    domain: "bytewise.lol",
    url: "https://bytewise.lol",
    icon: pathTo("sites/bytewise.png"),
    lightWell: false,
  },
  {
    id: "nen",
    name: "Nen",
    domain: "trynen.xyz",
    url: "https://trynen.xyz",
    icon: pathTo("sites/nen.png"),
    lightWell: true,
  },
  {
    id: "learnllm",
    name: "LearnLLM",
    domain: "learnllm.online",
    url: "https://learnllm.online",
    icon: pathTo("sites/learnllm.svg"),
    lightWell: false,
  },
  {
    id: "contribute-pulse",
    name: "Contribute Pulse",
    domain: "contribute-pulse.vercel.app",
    url: pathTo(""),
    icon: pathTo("sites/contribute-pulse.svg"),
    lightWell: false,
  },
  {
    id: "premium-taste",
    name: "Premium Taste",
    domain: "02-os.github.io/premium-taste",
    url: "https://02-os.github.io/premium-taste/",
    icon: pathTo("sites/premium-taste.png"),
    lightWell: true,
  },
];
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>
      <a
        class="footer-brand"
        href={pathTo("")}
        aria-label="Contribute Pulse home"
      >
        contributepulse<span class="brand-dot">.</span>
      </a>
      <span class="footer-tagline">
        A little signal for your next contribution.
      </span>
    </p>
    <div class="footer-center">
      <p class="footer-caption">Made for the people who make open source.</p>
      <div class="footer-network">
        <a
          class="site-network-label"
          href="https://csy20.me/ring"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View all ${connectedSites.length} connected sites`}
        >
          Sites
        </a>
        <div class="site-network-stack">
          {
            connectedSites.map((site, index) => {
              const isCurrent = site.id === "contribute-pulse";
              const tipClass =
                index === 0
                  ? "site-network-tooltip site-network-tooltip-start"
                  : index === connectedSites.length - 1
                    ? "site-network-tooltip site-network-tooltip-end"
                    : "site-network-tooltip";
              return (
                <a
                  class:list={[
                    "site-network-avatar",
                    { "is-light-well": site.lightWell },
                  ]}
                  href={site.url}
                  aria-current={isCurrent ? "page" : undefined}
                  target={isCurrent ? undefined : "_blank"}
                  rel={isCurrent ? undefined : "noopener noreferrer"}
                  aria-label={
                    isCurrent
                      ? `${site.name} — current site`
                      : `${site.name} — ${site.domain} (opens in a new tab)`
                  }
                >
                  <span class="site-network-well">
                    <img
                      src={site.icon}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class={tipClass} aria-hidden="true">
                    <strong>{site.name}</strong>
                    <span>{isCurrent ? "here" : site.domain}</span>
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={pathTo("about/")}>About</a>
      <a href="https://github.com/csy20/contribute-pulse">
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href="https://coff.ee/the__csy20" rel="noopener noreferrer">
        Buy me a coffee <span aria-hidden="true">↗</span>
      </a>
      <span>MIT</span>
    </nav>
  </div>
</footer>
