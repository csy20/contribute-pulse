---
import { pathTo } from "../lib/paths.ts";
import { latest } from "../lib/data.ts";
import { relativeTime } from "../lib/format.ts";
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-moss sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      Data generated
      <time datetime={latest.generatedAt} data-relative>{relativeTime(latest.generatedAt)}</time>.
      Next crawl daily at 02:00 UTC.
    </p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a class="hover:text-ink" href={pathTo("about/")}>How scoring works</a>
      <a class="hover:text-ink" href="https://github.com/csy20/contribute-pulse">Source</a>
      <span>MIT</span>
    </p>
  </div>
</footer>
