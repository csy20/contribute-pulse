---
import { CATEGORY_NAME } from "../../scripts/types.ts";
import type { Repo } from "../../scripts/types.ts";
import { formatScore, formatStars, relativeTime } from "../lib/format.ts";
import { categoryPath, repoPath } from "../lib/paths.ts";
import { avatarUrl, languageColor } from "../lib/ui.ts";

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const why = repo.why[0] ?? "Active project with room for contributors";
const issue = repo.issues[0];
const langColor = languageColor(repo.language);
---

<article class="card flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <a class="flex min-w-0 items-center gap-2.5" href={repo.url} rel="noopener noreferrer">
      <img
        src={avatarUrl(repo.owner, 64)}
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 rounded-[6px] bg-panel-2"
        loading="lazy"
      />
      <span class="min-w-0 leading-snug">
        <span class="block truncate text-[13px] text-moss">{repo.owner}</span>
        <span class="block truncate font-medium text-ink">{repo.name}</span>
      </span>
    </a>
    <span
      class="score-capsule"
      title={`Contribute score ${formatScore(repo.contributeScore)} — freshness and maintainer activity weighted highest`}
    >
      {formatScore(repo.contributeScore)}
    </span>
  </div>

  <p class="line-clamp-2 text-sm leading-snug text-moss">{repo.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {
      repo.language && (
        <span class="pill">
          <span class="lang-dot" style={`background:${langColor}`}></span>
          {repo.language}
        </span>
      )
    }
    {
      repo.categories.slice(0, 2).map((c) => (
        <a class="pill hover:text-ink" href={categoryPath(c)}>
          {CATEGORY_NAME[c]}
        </a>
      ))
    }
  </div>

  <p class="flex gap-2 text-[13px] leading-snug text-ink/90">
    <svg class="why-tick" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path
        d="M1 6h2.1l1-3.2L6.2 10l1.3-4H11"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <span>{why}</span>
  </p>

  <div class="grid grid-cols-3 gap-2 border-t border-line pt-3">
    <div class="meta-cell">
      <span class="lbl">Stars</span>
      <span class="val">{formatStars(repo.stars)}</span>
    </div>
    <div class="meta-cell">
      <span class="lbl">Pushed</span>
      <span class="val">
        <time datetime={repo.pushedAt} data-relative>{relativeTime(repo.pushedAt)}</time>
      </span>
    </div>
    <div class="meta-cell">
      <span class="lbl">Issues</span>
      <span class="val">{repo.issues.length}</span>
    </div>
  </div>

  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
    <a class="btn-ghost h-8 text-xs" href={repo.url} rel="noopener noreferrer">Open GitHub</a>
    {
      issue && (
        <a class="text-sm text-moss hover:text-ink hover:underline" href={issue.url} rel="noopener noreferrer">
          Issue #{issue.number}
        </a>
      )
    }
    <a class="text-sm text-moss hover:text-ink hover:underline" href={repoPath(repo.owner, repo.name)}>
      Details
    </a>
  </div>
</article>
