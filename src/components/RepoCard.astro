---
import { CATEGORY_NAME } from "../../scripts/types.ts";
import type { Repo } from "../../scripts/types.ts";
import { formatScore, formatStars, relativeTime } from "../lib/format.ts";
import { categoryPath, repoPath } from "../lib/paths.ts";

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const why = repo.why[0] ?? "Active project with room for contributors";
const issue = repo.issues[0];
---

<article class="card flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <a class="font-medium leading-snug hover:text-lime" href={repo.url} rel="noopener noreferrer">
      {repo.fullName}
    </a>
    <span class="font-mono text-lime tabular-nums" title="Contribute score">{formatScore(repo.contributeScore)}</span>
  </div>
  <p class="line-clamp-2 text-sm leading-relaxed text-moss">{repo.description}</p>
  <div class="flex flex-wrap gap-1.5">
    {repo.language && <span class="pill">{repo.language}</span>}
    {
      repo.categories.slice(0, 3).map((c) => (
        <a class="pill hover:text-ink" href={categoryPath(c)}>
          {CATEGORY_NAME[c]}
        </a>
      ))
    }
  </div>
  <p class="text-sm text-ink/90">{why}</p>
  <p class="text-xs text-moss">
    ★ {formatStars(repo.stars)}
    · pushed <time datetime={repo.pushedAt} data-relative>{relativeTime(repo.pushedAt)}</time>
    · {repo.issues.length} starter {repo.issues.length === 1 ? "issue" : "issues"}
  </p>
  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
    <a class="text-sm text-lime hover:underline" href={repo.url} rel="noopener noreferrer">GitHub</a>
    {
      issue && (
        <a class="text-sm text-moss hover:text-lime" href={issue.url} rel="noopener noreferrer">
          Issue #{issue.number}
        </a>
      )
    }
    <a class="text-sm text-moss hover:text-ink" href={repoPath(repo.owner, repo.name)}>Score details</a>
  </div>
</article>
