---
import type { ScoreBreakdown } from "../../scripts/types.ts";

interface Props {
  breakdown: ScoreBreakdown;
}

const { breakdown } = Astro.props;

const rows: { key: keyof ScoreBreakdown; label: string; weight: string }[] = [
  { key: "freshness", label: "Freshness", weight: "28%" },
  { key: "maintainerSignal", label: "Maintainer signal", weight: "24%" },
  { key: "issueQuality", label: "Issue quality", weight: "20%" },
  { key: "starBand", label: "Star band", weight: "18%" },
  { key: "projectHealth", label: "Project health", weight: "10%" },
];
---

<div class="score-bars">
  {
    rows.map((row) => {
      const value = breakdown[row.key];
      const width = Math.max(0, Math.min(100, value));
      return (
        <div
          role="img"
          aria-label={`${row.label} ${value.toFixed(0)} of 100, weight ${row.weight}`}
        >
          <div class="score-bar-label">
            <span>
              {row.label}
              <span class="score-weight">{row.weight}</span>
            </span>
            <span class="score-value">{value.toFixed(0)}</span>
          </div>
          <div class="score-track">
            <div class="score-fill" style={`width: ${width}%`}></div>
          </div>
        </div>
      );
    })
  }
</div>
