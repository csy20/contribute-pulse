---
import { pathTo } from "../lib/paths.ts";

interface Props {
  searchValue?: string;
  home?: boolean;
}

const { searchValue = "", home = false } = Astro.props;
---

<header data-header class="sticky top-0 z-30 border-b border-line/80 bg-canvas/80 backdrop-blur-md">
  <nav class="shell flex h-[52px] items-center gap-3 sm:h-14" aria-label="Primary">
    <a href={pathTo("")} class="flex min-w-0 items-center gap-2 text-ink hover:text-ink">
      <svg width="20" height="20" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path
          d="M3 16h5l2.5-7 4 14 3-9 2 4H29"
          stroke="currentColor"
          class="text-lime"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="truncate text-[15px] tracking-tight">
        <span class="hidden font-medium min-[420px]:inline">Contribute</span>
        <span class="font-display text-[1.15rem] leading-none min-[420px]:ml-1">Pulse</span>
      </span>
    </a>

    {
      !home && (
        <form class="search-wrap min-w-0 flex-1" action={pathTo("")} method="get" role="search">
          <label class="sr-only" for="header-search">Search the board</label>
          <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <input
            id="header-search"
            data-header-search
            type="search"
            name="q"
            value={searchValue}
            placeholder="Search"
            class="field h-11 min-h-11 pl-8 text-sm"
            autocomplete="off"
          />
        </form>
      )
    }

    <div class="ml-auto flex shrink-0 items-center gap-4">
      <a href={pathTo("about/")} class="inline-flex min-h-11 items-center text-sm text-moss hover:text-ink">
        About
      </a>
      <a
        class="inline-flex min-h-11 items-center gap-1.5 text-sm text-moss hover:text-ink"
        href="https://coff.ee/the__csy20"
        rel="noopener noreferrer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 8h12v7a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
          <path
            d="M16 10h2.2A2.8 2.8 0 0 1 21 12.8v0A2.8 2.8 0 0 1 18.2 15.6H16"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
          <path d="M8 4c.4 1 .4 2 0 3M12 4c.4 1 .4 2 0 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
        <span><span class="hidden min-[480px]:inline">Buy me a </span>coffee</span>
      </a>
    </div>
  </nav>
</header>
