---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StaleBanner from "../components/StaleBanner.astro";
import { pathTo } from "../lib/paths.ts";
import { latest } from "../lib/data.ts";

interface Props {
  title: string;
  description?: string;
  searchValue?: string;
  home?: boolean;
}

const {
  title,
  description = "Find a repo that is alive — and will notice your pull request.",
  searchValue = "",
  home = false,
} = Astro.props;

const origin = Astro.site ?? new URL("https://csy20.me");
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImage = new URL(pathTo("og.png"), origin).toString();
const fontFaces = `
  @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url("${pathTo("fonts/inter-latin.woff2")}") format("woff2"); }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F8F9F6" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href={pathTo("favicon.svg") + "?v=green-20261004"}
      type="image/svg+xml"
    />
    <link
      rel="preload"
      href={pathTo("fonts/inter-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:global set:html={fontFaces} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Contribute Pulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="Contribute Pulse — find a repo that is alive and will notice your pull request."
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="font-sans antialiased" data-page={home ? "home" : "inner"}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header searchValue={searchValue} home={home} />
    <StaleBanner generatedAt={latest.generatedAt} source={latest.source} />
    <main id="main" class="shell main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import { hydrateRelativeTimes } from "../lib/client-data.ts";
      hydrateRelativeTimes();
    </script>
  </body>
</html>
